server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Igual que los rewrites de vercel.json: /api/* va al backend con la ruta completa
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # Todo lo demás: la app de React
    location / {
        try_files $uri $uri/ /index.html;
    }
}
